rules_version = '2';

/**
 * OnCall — Firestore security rules.
 *
 * The roster holds named hospital staff and their personal mobile numbers, so
 * these rules are the whole security model: anything a client can reach, it can
 * reach directly, without going through the app. Deny by default and open only
 * what a signed-in member of that one organization needs.
 *
 * Membership and role live in custom claims set server-side when an account is
 * provisioned, never in a document the client could edit into a promotion.
 *
 * Deploy with:  firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /* The platform operator, above any tenant. Onboarding runs through them:
       a company asks for an organization, the operator creates it and names
       their first Admin, and that Admin runs their own roster from there.
       Deliberately not grantable from inside the app — see the people rules. */
    function isOwner() {
      return signedIn() && request.auth.token.owner == true;
    }

    /* Which tenant this token belongs to. */
    function memberOf(orgId) {
      return signedIn() && request.auth.token.orgId == orgId;
    }

    function roleIn(orgId, roles) {
      return memberOf(orgId) && request.auth.token.role in roles;
    }

    function isManager(orgId) {
      return roleIn(orgId, ['manager']);
    }

    function isSupervisor(orgId) {
      return roleIn(orgId, ['manager', 'supervisor']);
    }

    /* Someone still holding a temp password gets to change it and nothing
       else — no reading the roster on the way past. */
    function passwordSettled() {
      return signedIn() && request.auth.token.mustChangePassword != true;
    }

    match /orgs/{orgId} {
      /* An organization exists because the operator created it after the
         company asked to join. Nobody self-registers, and an Admin cannot mint
         a second tenant — that is the billing boundary as much as the security
         one. Members read their own org's branding and unit name. */
      allow read: if memberOf(orgId) && passwordSettled();
      allow create, delete: if isOwner();
      /* The operator owns the tenancy record. Anything an Admin should be able
         to change about their own org belongs in a settings subcollection with
         its own rule, not in this document. */
      allow update: if isOwner();

      match /people/{personId} {
        /* Everyone in the org needs the phone list. */
        allow read: if memberOf(orgId) && passwordSettled();

        /* Running the roster is the Admin's job, and the whole point of the
           model: the operator seats the first Admin, they take it from there.
           Nobody edits their own record — access level and active status are
           exactly what an attacker would reach for, and the fields worth
           self-serving (password, email) belong to Firebase Auth, not us. */
        allow create, update, delete: if isManager(orgId)
                                      && passwordSettled()
                                      && personId != request.auth.uid;

        /* An Admin promoting someone here changes a roster document, not what
           that person can actually do. Real privileges live in custom claims,
           which only the provisioning function sets — and it must refuse to
           grant `owner` from a tenant request, or an Admin could write
           themselves a document that promotes them off their own tenant. */
      }

      match /shifts/{shiftId} {
        allow read: if memberOf(orgId) && passwordSettled();

        /* Laying out the schedule is management. Staff move shifts by
           requesting, which is a write to /requests, not to the shift. */
        allow create, delete: if isSupervisor(orgId) && passwordSettled();
        allow update: if isSupervisor(orgId) && passwordSettled();
      }

      match /requests/{requestId} {
        allow read: if memberOf(orgId) && passwordSettled();

        /* A request has to be raised in your own name. Without this, anyone
           could post a colleague's shift out from under them. */
        allow create: if memberOf(orgId) && passwordSettled()
                      && request.resource.data.fromId == request.auth.uid
                      && request.resource.data.status == 'submitted';

        /* The person who raised it may retract it; the named co-worker may
           answer it; management decides. Anyone else, no. */
        allow update: if passwordSettled() && (
                        isSupervisor(orgId)
                        || (memberOf(orgId) && resource.data.fromId == request.auth.uid)
                        || (memberOf(orgId) && resource.data.toId == request.auth.uid)
                      );

        /* History is not the client's to erase — retracting sets a status. */
        allow delete: if false;
      }
    }

    /* Requests to join the platform. A company reaches the operator by email
       today; if that ever becomes a form on the site, it writes here. Write-only
       for the public, readable only by the operator — otherwise the list of who
       is evaluating the product would be readable by anyone. */
    match /joinRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isOwner();
    }

    /* Anything not named above stays closed. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
