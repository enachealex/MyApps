rules_version = '2';

/**
 * OnCall — Firestore security rules.
 *
 * The roster holds named hospital staff and their personal mobile numbers, so
 * these rules are the whole security model: anything a client can reach, it can
 * reach directly, without going through the app. Deny by default and open only
 * what a signed-in member of that one organization needs.
 *
 * Who someone is comes from documents the client cannot write for itself:
 *
 *   /operators/{email}                 the platform operator. No client can
 *                                      write here at all, so nobody can be
 *                                      promoted to it from inside the app.
 *   /orgs/{org}/members/{email}        { personId, kind, active } — membership
 *                                      and access level in one tenant, written
 *                                      by that tenant's Admin or the operator.
 *   /userIndex/{email}                 { orgId, personId } — how a signed-in
 *                                      person finds their tenant.
 *
 * These are keyed by email and trusted only when Firebase has VERIFIED that
 * email. Anyone can create an account under any address; without the
 * verification check they could claim a colleague's membership by registering
 * that colleague's email first.
 *
 * Earlier drafts used custom claims. Claims need a server to set them; this
 * arrangement needs none, so an Admin can run their roster with no Cloud
 * Function in the path.
 *
 * Tested by scripts/rules.test.mjs against the emulator:  npm run test:rules
 * Deploy with:  firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email;
    }

    function isOwner() {
      return verified() && exists(/databases/$(database)/documents/operators/$(email()));
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/members/$(email());
    }

    function isMember(orgId) {
      return verified() && exists(memberPath(orgId)) && get(memberPath(orgId)).data.active != false;
    }

    function kind(orgId) {
      return get(memberPath(orgId)).data.kind;
    }

    /* The roster id this signed-in person answers to in this tenant. */
    function me(orgId) {
      return get(memberPath(orgId)).data.personId;
    }

    function isManager(orgId) {
      return isMember(orgId) && kind(orgId) == 'manager';
    }

    function isSupervisor(orgId) {
      return isMember(orgId) && kind(orgId) in ['manager', 'supervisor'];
    }

    /* ---- departments ----
       A manager whose membership lists departments runs those departments
       only. No list, or an empty one, means the whole organization — that is
       the Admin. Which department a role belongs to comes from the call
       settings the Admin saved, or from the organization record if they have
       never saved any. */
    function scope(orgId) {
      return get(memberPath(orgId)).data.get('depts', []);
    }

    function isAdmin(orgId) {
      return isManager(orgId) && scope(orgId).size() == 0;
    }

    function settingsPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/settings/call;
    }

    function deptOf(orgId, role) {
      return exists(settingsPath(orgId))
        ? get(settingsPath(orgId)).data.get('depts', {}).get(role, 'Other')
        : get(/databases/$(database)/documents/orgs/$(orgId)).data.get('depts', {}).get(role, 'Other');
    }

    function manages(orgId, role) {
      return scope(orgId).size() == 0 || deptOf(orgId, role) in scope(orgId);
    }

    function shiftRole(orgId, shiftId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/shifts/$(shiftId)).data.role;
    }

    function personPath(orgId, personId) {
      return /databases/$(database)/documents/orgs/$(orgId)/people/$(personId);
    }

    /* ---- platform level ---- */

    match /operators/{entry} {
      /* You may learn whether you are an operator; nobody may become one. */
      allow get: if verified() && entry == email();
      allow list, write: if false;
    }

    match /userIndex/{entry} {
      allow get: if verified() && entry == email();
      allow list: if false;

      /* An Admin files an entry when they add someone, pointing at their own
         tenant only, and may not repoint an address that already belongs to a
         different tenant — that would be a way to pull someone else's staff
         into yours. */
      allow create: if isOwner() || isManager(request.resource.data.orgId);
      allow update: if isOwner()
                    || (isManager(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId);
      allow delete: if isOwner() || isManager(resource.data.orgId);
    }

    /* Requests to join the platform. Create-only for the public, readable only
       by the operator — otherwise the list of who is evaluating the product
       would be public. */
    match /joinRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isOwner();
    }

    /* ---- one tenant ---- */

    match /orgs/{orgId} {
      /* An organization exists because the operator created it after the
         company asked to join. An Admin cannot mint a second tenant — that is
         the billing boundary as much as the security one. */
      allow get: if isMember(orgId) || isOwner();
      allow list: if isOwner();
      allow create, update, delete: if isOwner();

      match /members/{entry} {
        /* Your own entry, so the app can learn your access level; Admins see
           the lot. */
        allow get: if (verified() && entry == email()) || isManager(orgId) || isOwner();
        allow list: if isManager(orgId) || isOwner();

        /* An Admin sets access levels in their own tenant, never their own —
           it is the first thing an attacker would reach for and there is no
           honest reason to change it yourself — and only to the three levels
           that exist. There is no value of `kind` that means operator. */
        allow create, update: if isOwner() || (
                                isAdmin(orgId)
                                && entry != email()
                                && request.resource.data.kind in ['staff', 'supervisor', 'manager']
                              );

        /* A department manager lets their own staff in and nothing more: the
           entry must be plain staff, carry no departments, and belong to a
           roster record in a department they run. They cannot raise anyone's
           access, their own included, or touch an entry that is already more
           than staff. getAfter, because the roster record is usually written
           in the same batch. */
        allow create: if isManager(orgId)
                      && entry != email()
                      && request.resource.data.kind == 'staff'
                      && request.resource.data.get('depts', []).size() == 0
                      && manages(orgId, getAfter(personPath(orgId, request.resource.data.personId)).data.role);
        allow update: if isManager(orgId)
                      && entry != email()
                      && resource.data.kind == 'staff'
                      && request.resource.data.kind == 'staff'
                      && request.resource.data.get('depts', []).size() == 0
                      && request.resource.data.personId == resource.data.personId
                      && manages(orgId, getAfter(personPath(orgId, resource.data.personId)).data.role);

        allow delete: if isOwner() || (isAdmin(orgId) && entry != email());
      }

      match /people/{personId} {
        /* Everyone in the org needs the phone list. */
        allow read: if isMember(orgId);

        /* The roster is the Admin's. Nobody edits their own record. */
        allow create, update, delete: if isAdmin(orgId) && personId != me(orgId);

        /* A department manager keeps the roster for their own departments:
           staff only, and both the role someone has and the role they are
           being given must be theirs — otherwise moving a person would be a
           way to reach into another department. */
        allow create: if isManager(orgId)
                      && personId != me(orgId)
                      && request.resource.data.kind == 'staff'
                      && manages(orgId, request.resource.data.role);
        allow update: if isManager(orgId)
                      && personId != me(orgId)
                      && resource.data.kind == 'staff'
                      && request.resource.data.kind == 'staff'
                      && manages(orgId, resource.data.role)
                      && manages(orgId, request.resource.data.role);
      }

      match /shifts/{shiftId} {
        allow read: if isMember(orgId);

        /* Laying out the schedule is management. */
        allow create: if isSupervisor(orgId) && manages(orgId, request.resource.data.role);
        allow delete: if isSupervisor(orgId) && manages(orgId, resource.data.role);

        /* Staff change exactly two things, and only on a shift they hold:
           whether it is posted to colleagues. Who holds a shift moves only
           through an approved request, which management writes. */
        allow update: if (
                        isSupervisor(orgId)
                        && manages(orgId, resource.data.role)
                        && manages(orgId, request.resource.data.role)
                      ) || (
                        isMember(orgId)
                        && resource.data.personId == me(orgId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['posted'])
                      );
      }

      match /requests/{requestId} {
        allow read: if isMember(orgId);

        /* A request is raised in your own name. Without this anyone could
           post a colleague's shift out from under them. Picking up a posted
           shift is the one case where you write yourself in as the taker of a
           request you did not open, and that is an update, below. */
        allow create: if (
                        isSupervisor(orgId)
                        && manages(orgId, shiftRole(orgId, request.resource.data.shiftId))
                      ) || (
                        isMember(orgId)
                        && request.resource.data.fromId == me(orgId)
                        && request.resource.data.status == 'submitted'
                      );

        /* The person who raised it, the co-worker named on it, anyone taking
           an open post, and management. Staff can withdraw or decline; they
           can never write "approved", which is what moves the shift. */
        allow update: if (
                        isSupervisor(orgId)
                        && manages(orgId, shiftRole(orgId, resource.data.shiftId))
                      ) || (
                        isMember(orgId)
                        && request.resource.data.status in ['submitted', 'retracted', 'denied']
                        && (
                          resource.data.fromId == me(orgId)
                          || resource.data.toId == me(orgId)
                          || (resource.data.toId == null && request.resource.data.toId == me(orgId))
                        )
                      );

        /* History is not the client's to erase — retracting sets a status. */
        allow delete: if false;
      }

      match /settings/{settingId} {
        /* The Admin's edits to the call template and the phone-button
           settings. Kept apart from the organization record above so that
           record — name, billing identity — stays the operator's alone.
           Everyone reads it, because it decides what their screens show. */
        allow read: if isMember(orgId);
        allow create, update: if isAdmin(orgId)
                              && settingId == 'call'
                              && request.resource.data.roles is list
                              && request.resource.data.slots is list;
        allow delete: if false;
      }

      match /timeOff/{entryId} {
        /* The scheduler needs everyone's days to generate around them. */
        allow read: if isMember(orgId);

        /* Your own availability only. No reason field exists and none should
           be added: the reason is usually medical. */
        allow create: if isMember(orgId)
                      && request.resource.data.personId == me(orgId)
                      && request.resource.data.keys().hasOnly(['personId', 'date']);
        allow delete: if isMember(orgId) && resource.data.personId == me(orgId);
        allow update: if false;
      }

      match /messages/{messageId} {
        /* Two people can read a message: the one who sent it and the one it
           was sent to. An Admin is not a third reader — they see a message
           only once somebody has reported it, which is what lets patient
           details be purged without making every conversation supervised. */
        allow read: if isMember(orgId) && (
                      resource.data.fromId == me(orgId)
                      || resource.data.toId == me(orgId)
                      || (kind(orgId) == 'manager' && resource.data.reported == true)
                    );

        allow create: if isMember(orgId)
                      && request.resource.data.fromId == me(orgId)
                      && request.resource.data.reported == false
                      && request.resource.data.body is string
                      && request.resource.data.body.size() <= 500;

        /* The recipient may mark it read or report it, and nothing else —
           nobody edits what was said after the fact. */
        allow update: if isMember(orgId)
                      && resource.data.toId == me(orgId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'reported']);

        allow delete: if isMember(orgId) && (
                        resource.data.fromId == me(orgId)
                        || (kind(orgId) == 'manager' && resource.data.reported == true)
                      );
      }
    }

    /* Anything not named above stays closed. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
