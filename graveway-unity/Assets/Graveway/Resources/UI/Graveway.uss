/* Graveway's screens, ported from the CSS in graveway/index.html. Sizes are
   in points on a 390 x 844 reference screen (PanelSettings scales them).
   Colours:
     background #0d1418   panel rgba(13, 20, 24, 0.82)   line rgba(255,255,255,0.1)
     text #e9efe2         dim #8b9a94                    accent #9be15d
     blood #ff4d4d        armor #4aa8ff                  gold #ffc928          */

.gw-root { flex-grow: 1; color: rgb(233, 239, 226); font-size: 15px; }

/* ── Shared ───────────────────────────────────────────────────────────── */
.chip {
    padding: 6px 10px; border-radius: 10px; background-color: rgba(13, 20, 24, 0.82);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); -unity-font-style: bold;
}
.btn {
    min-height: 48px; margin: 5px 0; padding: 0 20px; border-radius: 14px; border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12); background-color: rgba(255, 255, 255, 0.07);
    color: rgb(233, 239, 226); font-size: 16px; -unity-font-style: bold;
}
.btn:hover { background-color: rgba(255, 255, 255, 0.11); }
.btn:active { scale: 0.97 0.97; }
.btn.primary { background-color: rgb(155, 225, 93); color: rgb(16, 26, 10); border-width: 0; }
.btn.big { min-height: 60px; font-size: 24px; letter-spacing: 3px; }
.bar {
    height: 10px; border-radius: 6px; background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); overflow: hidden;
}
.bar-fill { height: 100%; width: 100%; background-color: rgb(155, 225, 93); }
.icon-btn {
    width: 44px; height: 44px; border-radius: 12px; background-color: rgba(13, 20, 24, 0.82);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); align-items: center; justify-content: center;
}
.icon-text { font-size: 16px; -unity-font-style: bold; }

/* ── In-run HUD ───────────────────────────────────────────────────────── */
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.h-top { flex-direction: row; align-items: center; padding: 10px 12px 0 12px; }
.h-dist { font-size: 26px; margin-right: 10px; }
.h-stage { flex-grow: 1; margin-right: 10px; }
.h-stage-label { font-size: 11px; color: rgb(155, 225, 93); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 4px; }
.h-prog { height: 8px; }
.h-coins { color: rgb(255, 201, 40); margin-right: 10px; }
.h-kills { position: absolute; left: 12px; top: 62px; font-size: 12px; color: rgb(139, 154, 148); -unity-font-style: bold; }
.h-boss { position: absolute; left: 15%; right: 15%; top: 64px; align-items: center; }
.h-boss-label { font-size: 14px; color: rgb(255, 154, 138); -unity-font-style: bold; letter-spacing: 2px; }
.h-boss-bar { width: 100%; margin-top: 4px; border-color: rgba(255, 80, 80, 0.4); }
.h-boss-bar .bar-fill { background-color: rgb(255, 77, 77); }

.h-bottom {
    position: absolute; left: 0; right: 0; bottom: 0; flex-direction: row; align-items: flex-end;
    justify-content: space-between; padding: 0 12px 14px 12px;
}
.vitals { width: 46%; max-width: 220px; }
.vital-row { flex-direction: row; align-items: center; margin-top: 6px; }
.vital-row .bar { flex-grow: 1; height: 14px; }
.vital-n { min-width: 34px; margin-left: 8px; font-size: 14px; -unity-font-style: bold; }
.hp .bar-fill { background-color: rgb(255, 77, 77); }
.armor { height: 9px; }
.armor .bar-fill { background-color: rgb(74, 168, 255); }

.weap { align-items: flex-end; }
.wbar { align-items: flex-end; margin-bottom: 8px; }
.wbtn {
    width: 92px; height: 40px; margin-top: 6px; border-radius: 12px; background-color: rgba(13, 20, 24, 0.82);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); justify-content: center; padding-left: 8px; overflow: hidden;
}
.wbtn.on { border-color: rgb(155, 225, 93); background-color: rgba(30, 46, 22, 0.92); }
.wbtn-n { position: absolute; left: 5px; top: 2px; font-size: 9px; color: rgb(139, 154, 148); -unity-font-style: bold; }
.wbtn-name { font-size: 11px; -unity-font-style: bold; margin-left: 6px; }
.wbtn.on .wbtn-name { color: rgb(155, 225, 93); }
.wbtn-ammo { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background-color: rgba(255, 255, 255, 0.35); }
.wbtn.on .wbtn-ammo { background-color: rgb(155, 225, 93); }

.weapon-card {
    min-width: 132px; padding: 10px 14px; border-radius: 16px; background-color: rgba(13, 20, 24, 0.82);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); align-items: flex-end; overflow: hidden;
}
.wname { font-size: 12px; color: rgb(139, 154, 148); -unity-font-style: bold; letter-spacing: 1px; }
.ammo-row { flex-direction: row; align-items: flex-end; }
.ammo { font-size: 32px; -unity-font-style: bold; }
.mag { font-size: 14px; color: rgb(139, 154, 148); margin-left: 4px; margin-bottom: 5px; }
.tap { font-size: 10px; color: rgb(139, 154, 148); letter-spacing: 1px; margin-top: 2px; }
.weapon-card.empty .ammo { color: rgb(255, 77, 77); }
.weapon-card.reloading .ammo { color: rgb(155, 225, 93); }
.reload-fill { position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background-color: rgb(155, 225, 93); }

.stick-base {
    position: absolute; border-radius: 999px; border-width: 2px; border-color: rgba(255, 255, 255, 0.22);
    background-color: rgba(255, 255, 255, 0.05);
}
.stick-knob {
    position: absolute; border-radius: 999px; background-color: rgba(255, 255, 255, 0.28);
    border-width: 2px; border-color: rgba(255, 255, 255, 0.45);
}

.vignette { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(170, 0, 0, 0.35); opacity: 0; }

.banner { position: absolute; left: 0; right: 0; top: 30%; align-items: center; display: none; }
.banner-t { font-size: 40px; -unity-font-style: bold; letter-spacing: 2px; -unity-text-align: middle-center; }
.banner-s { margin-top: 6px; -unity-font-style: bold; color: rgb(213, 221, 210); -unity-text-align: middle-center; white-space: normal; padding: 0 20px; }

/* ── Menu ─────────────────────────────────────────────────────────────── */
.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.menu { justify-content: space-between; padding: 16px 16px 20px 16px; }
.title { align-items: center; margin-top: 60px; }
.title-main { font-size: 72px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(233, 239, 226); }
.title-sub { margin-top: 8px; color: rgb(139, 154, 148); }
.menu-bottom { width: 100%; max-width: 420px; align-self: center; }
.pick {
    flex-direction: row; align-items: center; padding: 8px; border-radius: 18px;
    background-color: rgba(13, 20, 24, 0.82); border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
}
.arrow { width: 44px; min-height: 64px; padding: 0; font-size: 30px; }
.who { flex-grow: 1; flex-shrink: 1; align-items: center; padding: 0 6px; }
.who-name { font-size: 28px; -unity-font-style: bold; letter-spacing: 2px; }
.who-role { font-size: 12px; color: rgb(155, 225, 93); -unity-font-style: bold; }
.who-perk { font-size: 12px; color: rgb(139, 154, 148); white-space: normal; -unity-text-align: middle-center; margin-top: 4px; }
.menu-stats { align-items: center; margin: 10px 0 4px 0; }
.menu-best { font-size: 18px; -unity-font-style: bold; }
.menu-runs { font-size: 12px; color: rgb(139, 154, 148); }
.hint { margin-top: 4px; font-size: 13px; color: rgb(139, 154, 148); -unity-text-align: middle-center; white-space: normal; }

/* ── Cards ────────────────────────────────────────────────────────────── */
.modal {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;
    background-color: rgba(5, 8, 10, 0.66); padding: 20px;
}
.card {
    width: 100%; max-width: 380px; padding: 22px; border-radius: 22px; background-color: rgb(16, 24, 28);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); align-items: stretch;
}
.card-title { font-size: 40px; -unity-font-style: bold; letter-spacing: 2px; -unity-text-align: middle-center; }
.card-title.red { color: rgb(255, 77, 77); }
.card-sub { color: rgb(139, 154, 148); margin: 6px 0 14px 0; -unity-text-align: middle-center; }
.r-dist { font-size: 56px; -unity-font-style: bold; -unity-text-align: middle-center; }
.r-stats { white-space: normal; margin-bottom: 8px; font-size: 15px; }
.r-wallet { font-size: 13px; color: rgb(139, 154, 148); margin-bottom: 10px; -unity-text-align: middle-center; }
